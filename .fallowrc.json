{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignorePatterns": [
    "convex/_generated/**",
    "components/ui/**"
  ],
  "ignoreDependencies": [
    "@hookform/resolvers",
    "immer",
    "react-hook-form",
    "convex-test",
    "@edge-runtime/vm",
    "react-doctor",
    "class-variance-authority",
    "lucide-react",
    "next-themes",
    "radix-ui",
    "sonner"
  ],
  "health": {
    "maxCrap": 250,
    "maxCognitive": 25
  },
  "duplicates": {
    "minOccurrences": 2
  },
  "rules": {
    "unused-dependencies": "error",
    "css-dead-surface": "off"
  }
}
